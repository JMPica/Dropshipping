          }
        },
        "pregunta-4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Qué formas de pago aceptáis?",
            "respuesta": "<p>Tarjeta de crédito o débito y los métodos que ves al pagar. El pago es 100 % seguro y nunca vemos los datos de tu tarjeta.</p>"
          }
        },
        "pregunta-5": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Tiene garantía?",
            "respuesta": "<p>Sí, todos nuestros productos tienen la garantía legal de 3 años frente a defectos de fabricación.</p>"
          }
        },
        "pregunta-6": {
          "type": "pregunta",
          "settings": {
