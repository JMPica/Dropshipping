{{ 'lu-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
    color: {{ section.settings.color_texto }};
  }
  #shopify-section-{{ section.id }} .lu-marquesina__item { font-size: {{ section.settings.tamano }}px; }
  #shopify-section-{{ section.id }} .lu-marquesina__pista { --lu-velocidad: {{ section.settings.velocidad }}s; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .lu-marquesina__item { font-size: {{ section.settings.tamano | times: 0.7 | round }}px; }
  }
{% endstyle %}

<section class="lu-section lu-marquesina" aria-label="{{ section.settings.etiqueta | escape }}">
  <div class="lu-marquesina__pista">
    {%- for i in (1..2) -%}
      <div class="lu-marquesina__grupo"{% if forloop.last %} aria-hidden="true"{% endif %}>
        {%- for n in (1..3) -%}
          {%- for block in section.blocks -%}
            <span class="lu-marquesina__item" {{ block.shopify_attributes }}>
              {{- block.settings.texto -}}
              <span class="lu-marquesina__sep">{{ section.settings.separador }}</span>
            </span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lume – Cinta animada",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "etiqueta", "label": "Descripción para lectores de pantalla", "default": "Ventajas de Lume" },
    { "type": "text", "id": "separador", "label": "Separador entre frases", "default": "✦" },
    { "type": "range", "id": "velocidad", "label": "Duración de una vuelta (segundos, más = más lento)", "min": 10, "max": 120, "step": 5, "unit": "s", "default": 45 },
    { "type": "range", "id": "tamano", "label": "Tamaño del texto (px)", "min": 14, "max": 60, "step": 1, "unit": "px", "default": 26 },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_fondo", "label": "Fondo", "default": "#161513" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#F9F8F4" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "frase",
      "name": "Frase",
      "settings": [
        { "type": "text", "id": "texto", "label": "Texto", "default": "Adiós a las durezas" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lume – Cinta animada",
      "blocks": [
        { "type": "frase", "settings": { "texto": "Adiós a las durezas" } },
        { "type": "frase", "settings": { "texto": "Talones suaves en minutos" } },
        { "type": "frase", "settings": { "texto": "Envío con seguimiento" } },
        { "type": "frase", "settings": { "texto": "14 días para devolver" } }
      ]
    }
  ]
}
{% endschema %}
