{{ 'lu-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lu-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
  #shopify-section-{{ section.id }} .lu-cta__caja {
    background: {{ section.settings.color_caja }};
    color: {{ section.settings.color_texto }};
    text-align: {{ section.settings.text_align }};
  }
  #shopify-section-{{ section.id }} .lu-h2 { font-size: {{ section.settings.heading_size }}px; }
  #shopify-section-{{ section.id }} .lu-body { font-size: {{ section.settings.body_size }}px; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .lu-h2 { font-size: {{ section.settings.heading_size | times: 0.66 | round }}px; }
  }
{% endstyle %}

<section class="lu-section lu-cta">
  <div class="lu-container">
    <div class="lu-cta__caja lu-reveal{% if section.settings.text_align == 'center' %} lu-center{% endif %}">
      {%- if section.settings.luz -%}<span class="lu-cta__luz" aria-hidden="true"></span>{%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="lu-eyebrow" style="color: {{ section.settings.color_acento }}">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="lu-h2">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}
        <p class="lu-body">{{ section.settings.texto | newline_to_br }}</p>
      {%- endif -%}
      {%- if section.settings.boton != blank -%}
        <div class="lu-hero__acciones">
          <a class="lu-btn lu-btn--invertido" href="{{ section.settings.boton_url | default: routes.all_products_collection_url }}"><span>{{ section.settings.boton }}</span>{% render 'lu-icono', nombre: 'flecha' %}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lume – Llamada final",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Tu momento" },
    { "type": "inline_richtext", "id": "titulo", "label": "Título", "default": "Empieza hoy a cuidar tu pelo <em>como mereces</em>" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Envío con seguimiento a toda España y 14 días para devolver. Sin riesgo." },
    { "type": "text", "id": "boton", "label": "Texto del botón", "default": "Ver la colección" },
    { "type": "url", "id": "boton_url", "label": "Enlace del botón" },
    { "type": "checkbox", "id": "luz", "label": "Efecto de luz animado", "default": true },
    { "type": "header", "content": "Tipografía" },
    { "type": "select", "id": "text_align", "label": "Alineación", "default": "center", "options": [
      { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Derecha" }
    ] },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 24, "max": 96, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 13, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_fondo", "label": "Fondo de la sección", "default": "#F6EFE7" },
    { "type": "color", "id": "color_caja", "label": "Fondo de la caja", "default": "#2A1F1A" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#F6EFE7" },
    { "type": "color", "id": "color_acento", "label": "Color del texto pequeño", "default": "#E9B87C" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "Lume – Llamada final" }]
}
{% endschema %}
